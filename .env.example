# Local development keeps the API allowlist at http://localhost:3000 when unset.
# For the Railway preview, replace the placeholder with the exact Vercel production origin:
# ALLOWED_ORIGINS=https://<VERCEL-PRODUCTION-ORIGIN>

# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# For Vercel production, use the exact Railway public URL:
# NEXT_PUBLIC_API_URL=https://usmora-production.up.railway.app
